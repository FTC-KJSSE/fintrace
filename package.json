{
  "name": "fintrace",
  "productName": "FinTrace",
  "version": "1.0.0",
  "description": "Real-time network latency and financial infrastructure route telemetry desktop application",
  "author": "FinTrace Team",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fintrace.app",
    "productName": "FinTrace",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "frontend/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FinTrace",
      "uninstallDisplayName": "FinTrace"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
